---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      body {
        display: flex;
        flex-direction: column;
      }
      main {
        width: 680px;
        flex: 1;
      }
      footer {
        margin-top: auto;
        padding: 0;
        background-color: red;
      }
      ul {
        display: flex;
        flex-direction: column;
        gap: 2.7rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li a {
        display: block;
        color: inherit;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 6px;
        transition: background-color 140ms ease-out;
        cursor: pointer;
      }
      ul li a:hover {
        background-color: #f7ebe5;
        color: inherit;
      }
      ul li a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 8px;
        border-radius: 2px;
      }
      .title {
        margin: 0;
        color: var(--text-color);
        font-size: 32px;
        font-weight: 400;
        letter-spacing: -0.4px;
        line-height: 1.08;
        text-wrap: pretty;
        transition: color 150ms ease;
      }
      .subtitle {
        max-width: 42rem;
        margin: 0.38rem 0 0;
        color: var(--accent);
        font-size: clamp(1rem, 2.2vw, 1.28rem);
        line-height: 1.25;
        text-wrap: pretty;
      }
      .date {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 10px;
        color: #88756b;
        font-family: var(--sans-serif-stack);
        font-size: 12px;
        font-variant-numeric: tabular-nums;
        font-weight: 650;
        letter-spacing: 1px;
        line-height: 1.3;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .date::after {
        width: 40px;
        height: 1px;
        background: #ccbdb5;
        content: '';
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section>
        <ul>
          {
            posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <p class="date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                  <h4 class="title">{post.data.title}</h4>
                  {post.data.subtitle && (
                    <p class="subtitle">{post.data.subtitle}</p>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>
