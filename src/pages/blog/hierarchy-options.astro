---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const options = [
  {
    id: 'date-rail',
    number: '01',
    title: 'Date rail',
    note: 'The date becomes a quiet index, while the writing stays together.',
  },
  {
    id: 'date-kicker',
    number: '02',
    title: 'Date kicker',
    note: 'A compact, editorial rhythm that works especially well on narrow screens.',
  },
  {
    id: 'date-aside',
    number: '03',
    title: 'Date aside',
    note: 'The title leads; the date is easy to find without competing with it.',
  },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Blog hierarchy options"
      description="Layout studies for the blog index title, subtitle and date hierarchy."
    />
    <style>
      :global(body) {
        min-height: 100%;
        display: flex;
        flex-direction: column;
      }

      main {
        width: min(1080px, calc(100% - 3rem));
        max-width: none;
        flex: 1;
        padding: clamp(4rem, 9vw, 8rem) 0 6rem;
      }

      .intro {
        max-width: 680px;
        margin-bottom: clamp(4rem, 8vw, 7rem);
      }

      .eyebrow,
      .option-number,
      .post-date {
        font-family:
          ui-sans-serif,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        font-variant-numeric: tabular-nums;
      }

      .eyebrow {
        margin: 0 0 0.65rem;
        color: #88756b;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        line-height: 1.3;
        text-transform: uppercase;
      }

      .page-title {
        margin: 0;
        color: rgb(var(--black));
        font-size: clamp(2.4rem, 7vw, 4.5rem);
        font-variant-caps: normal;
        font-weight: 400;
        letter-spacing: -0.035em;
        line-height: 0.98;
      }

      .intro-copy {
        max-width: 35rem;
        margin: 1.25rem 0 0;
        color: #6f5b51;
        font-size: 1rem;
        line-height: 1.45;
      }

      .option + .option {
        margin-top: clamp(6rem, 12vw, 10rem);
      }

      .option-heading {
        display: grid;
        grid-template-columns: 2.5rem minmax(0, 1fr);
        gap: 1rem;
        align-items: baseline;
        margin-bottom: 2.5rem;
        padding-bottom: 0.9rem;
        border-bottom: 1px solid #dfd3cd;
      }

      .option-number {
        color: #9b8478;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
      }

      .option-title {
        margin: 0;
        color: rgb(var(--black));
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.2;
      }

      .option-note {
        grid-column: 2;
        margin: -0.45rem 0 0;
        color: #88756b;
        font-size: 0.84rem;
        line-height: 1.4;
      }

      .post-list {
        display: flex;
        flex-direction: column;
        gap: 0;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .post-link {
        color: inherit;
        text-decoration: none;
      }

      .post-title {
        margin: 0;
        color: rgb(var(--black));
        font-size: clamp(1.55rem, 3.2vw, 2.05rem);
        font-weight: 400;
        letter-spacing: -0.018em;
        line-height: 1.08;
        text-wrap: pretty;
      }

      .post-subtitle {
        margin: 0.38rem 0 0;
        color: var(--accent);
        font-size: clamp(1rem, 2.2vw, 1.28rem);
        line-height: 1.25;
        text-wrap: pretty;
      }

      .post-date {
        margin: 0;
        color: #88756b;
        font-size: 0.72rem;
        font-weight: 650;
        letter-spacing: 0.08em;
        line-height: 1.3;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .post-link:hover .post-title {
        color: var(--accent);
      }

      .post-link:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 8px;
        border-radius: 2px;
      }

      /* 01 — The date forms a separate, highly scannable column. */
      .date-rail .post-link {
        display: grid;
        grid-template-columns: 7rem minmax(0, 1fr);
        gap: 1.5rem;
        padding: 1.5rem 0;
        border-bottom: 1px solid #eadfda;
      }

      .date-rail .post-list-item:first-child .post-link {
        padding-top: 0;
      }

      .date-rail .post-date {
        padding-top: 0.42rem;
      }

      /* 02 — The date is a typographic cue above each headline. */
      .date-kicker .post-list {
        gap: 2.7rem;
        max-width: 760px;
      }

      .date-kicker .post-date {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 0.65rem;
      }

      .date-kicker .post-date::after {
        width: 2.5rem;
        height: 1px;
        background: #ccbdb5;
        content: '';
      }

      .date-kicker .post-subtitle {
        max-width: 42rem;
      }

      /* 03 — The date sits opposite the title, with the deck below. */
      .date-aside .post-link {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: 2rem;
        row-gap: 0.35rem;
        padding: 1.55rem 0;
        border-top: 1px solid #dfd3cd;
      }

      .date-aside .post-list-item:last-child .post-link {
        border-bottom: 1px solid #dfd3cd;
      }

      .date-aside .post-date {
        align-self: baseline;
        padding-top: 0.42rem;
      }

      .date-aside .post-subtitle {
        grid-column: 1;
      }

      @media (max-width: 640px) {
        main {
          width: min(100% - 2rem, 34rem);
          padding-top: 3.5rem;
        }

        .option-heading {
          grid-template-columns: 2rem minmax(0, 1fr);
          gap: 0.7rem;
        }

        .option-note {
          grid-column: 2;
        }

        .date-rail .post-link {
          grid-template-columns: 1fr;
          gap: 0.45rem;
          padding: 1.35rem 0;
        }

        .date-rail .post-date {
          grid-row: 2;
          padding-top: 0.15rem;
        }

        .date-rail .post-copy {
          grid-row: 1;
        }

        .date-aside .post-link {
          grid-template-columns: 1fr auto;
          column-gap: 1rem;
        }

        .date-aside .post-date {
          grid-column: 1;
          grid-row: 1;
          padding: 0;
        }

        .date-aside .post-title {
          grid-column: 1 / -1;
          grid-row: 2;
        }

        .date-aside .post-subtitle {
          grid-column: 1 / -1;
          grid-row: 3;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <header class="intro">
        <p class="eyebrow">Blog index study</p>
        <h1 class="page-title">Three ways to place the date</h1>
        <p class="intro-copy">
          Each option uses the same posts. The first deliberately has no
          subtitle, so the empty state is part of the comparison.
        </p>
      </header>

      {
        options.map((option) => (
          <section
            class:list={['option', option.id]}
            aria-labelledby={`${option.id}-title`}
          >
            <header class="option-heading">
              <span class="option-number" aria-hidden="true">
                {option.number}
              </span>
              <h2 class="option-title" id={`${option.id}-title`}>
                {option.title}
              </h2>
              <p class="option-note">{option.note}</p>
            </header>

            <ul class="post-list">
              {posts.map((post) => (
                <li class="post-list-item">
                  <a class="post-link" href={`/blog/${post.id}/`}>
                    {option.id === 'date-rail' ? (
                      <>
                        <p class="post-date">
                          <FormattedDate date={post.data.pubDate} />
                        </p>
                        <div class="post-copy">
                          <h3 class="post-title">{post.data.title}</h3>
                          {post.data.subtitle && (
                            <p class="post-subtitle">{post.data.subtitle}</p>
                          )}
                        </div>
                      </>
                    ) : option.id === 'date-kicker' ? (
                      <>
                        <p class="post-date">
                          <FormattedDate date={post.data.pubDate} />
                        </p>
                        <h3 class="post-title">{post.data.title}</h3>
                        {post.data.subtitle && (
                          <p class="post-subtitle">{post.data.subtitle}</p>
                        )}
                      </>
                    ) : (
                      <>
                        <h3 class="post-title">{post.data.title}</h3>
                        <p class="post-date">
                          <FormattedDate date={post.data.pubDate} />
                        </p>
                        {post.data.subtitle && (
                          <p class="post-subtitle">{post.data.subtitle}</p>
                        )}
                      </>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>
    <Footer />
  </body>
</html>
