---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      body {
        display: flex;
        flex-direction: column;
      }
      main {
        width: 42.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 4rem;
      }
      .welcome-para {
        text-wrap: pretty;
      }
      ul {
        display: flex;
        flex-direction: column;
        gap: 2.3rem;
        list-style-type: none;
        padding: 0;
        margin: 0;
        margin-left: -1rem;
      }
      ul li a {
        display: block;
        color: inherit;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        transition: background-color 140ms ease-out;
        cursor: pointer;
      }
      ul li a:hover {
        background-color: #f7ebe5;
        color: inherit;
      }
      ul li a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 0.5rem;
        border-radius: 0.125rem;
      }
      .writing-section {
        margin-bottom: 3rem;
      }
      .title {
        margin: 0;
        color: var(--text-color);
        font-size: 1.875rem;
        font-weight: 400;
        letter-spacing: -0.4px;
        line-height: 1.08;
        text-wrap: pretty;
        transition: color 150ms ease;
      }
      .subtitle {
        max-width: 42rem;
        margin: 0.38rem 0 0;
        color: var(--accent);
        font-size: 1.1875rem;
        line-height: 1.25;
        text-wrap: pretty;
      }
      .date {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        margin: 0 0 0.625rem;
        color: #88756b;
        font-family: var(--sans-serif-stack);
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
        font-weight: 650;
        letter-spacing: 1px;
        line-height: 1.3;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .date::after {
        width: 2.5rem;
        height: 1px;
        background: #ccbdb5;
        content: '';
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section>
        <p class="welcome-para">
          Welcome to my personal website. I'm a senior frontend developer from
          London and this is where I publish my thoughts, opinions, tips, what
          I'm learning about, and experiments.
        </p>
      </section>

      <section class="writing-section">
        <ul>
          {
            posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <p class="date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                  <h4 class="title">{post.data.title}</h4>
                  {post.data.subtitle && (
                    <p class="subtitle">{post.data.subtitle}</p>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>
